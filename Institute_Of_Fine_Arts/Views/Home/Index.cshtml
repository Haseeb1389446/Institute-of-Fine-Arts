    <div class="home-page">

    <!-- Hero Section -->
    <section class="hero">
        <div class="container">
            <h1>Where Creativity Meets Excellence</h1>
            <p style="color:lightgray;">Discover, create, and showcase your artistic talents in our vibrant community of artists and art enthusiasts.</p>
            <a href="#" class="btn btn-hero">Explore Opportunities <i class="fas fa-arrow-right ms-2"></i></a>
        </div>
    </section>

    <!-- Upcoming Competitions -->
    <section class="py-5">
        <div class="container py-5">
            <div class="section-title">
                <h2>Upcoming Competitions</h2>
            </div>
            <div class="row">
           @foreach(var upcomingCompetition in ViewBag.upcomingCompetition){
                <div class="col-md-4 mb-4">
                    <div class="card">
                            <img src="~/Uploads/images/@upcomingCompetition.Banner" class="card-img-top" alt="Spring Art Contest">
                        <div class="card-body">
                                <span class="badge-date">@upcomingCompetition.StartDate</span>
                                <h5 class="card-title mt-3">@upcomingCompetition.Title</h5>
                                <p class="card-text">@upcomingCompetition.Description</p>
                            <a href="#" class="btn btn-outline-primary mt-3">Learn More</a>
                        </div>
                    </div>
                </div>    
            }
                </div>
            <div class="text-center mt-4">
                <a href="#" class="btn btn-outline-dark">View All Competitions <i class="fas fa-arrow-right ms-2"></i></a>
            </div>
        </div>
    </section>

    <!-- Ongoing Competitions -->
    <section class="ongoing-section">
        <div class="container">
            <div class="ongoing-content">
                <h2 class="mb-4">Ongoing Competitions</h2>
                <div class="ongoing-count">@(ViewBag.ongoingCompetition?.Count ?? 0) Competitions Running</div>
                <p class="mb-4">Participate in our currently running competitions and showcase your talent to the world.</p>
                <a href="#" class="btn btn-primary">Participate Now <i class="fas fa-paint-brush ms-2"></i></a>
            </div>
        </div>
    </section>

    <!-- Winners Section -->
    <section class="py-5">
        <div class="container py-5">
            <div class="section-title">
                <h2>Recent Winners</h2>
            </div>
            <div class="row">
                @foreach (var award in ViewBag.awards)
                {
                <div class="col-md-4 mb-4">
                    <div class="winner-card">
                            <img src="https://placehold.co/200x200/d08c60/white?text=@(award.Student?.UserName)" class="winner-img" alt="Sarah Johnson">
                            @* <h4 class="winner-name">@(award.Student?.UserName ?? "null")</h4> *@
                            <h4 class="winner-name">@(award.Student?.UserName ?? "null")</h4>
                            <p class="winner-prize">Winner of @award.AwardTitle</p>
                        <p class="mt-3">"The Institute provided the perfect platform to showcase my work and connect with other artists."</p>
                    </div>
                </div>
                }
            </div>
        </div>
    </section>

    <!-- Announcements Section -->
    <section class="py-5 bg-light">
        <div class="container py-5">
            <div class="section-title">
                <h2>Announcements</h2>
            </div>
            <div class="row">
                <div class="col-md-6 mb-4">
                    <div class="announcement-card">
                        <img src="https://images.pexels.com/photos/6933319/pexels-photo-6933319.jpeg?cs=srgb&dl=pexels-mikhail-nilov-6933319.jpg&fm=jpg" class="announcement-img" alt="Exhibition">
                        <div class="announcement-overlay">
                            <h3>Colors of Dreams Exhibition</h3>
                            <p>August 15-30, 2025</p>
                            <p>Featuring works from emerging artists across the country</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-6 mb-4">
                    <div class="announcement-card">
                        <img src="https://www.befunky.com/images/wp/wp-2021-11-Photo-to-Poly-Art-2.jpeg?auto=avif,webp&format=jpg&width=944" class="announcement-img" alt="Workshops">
                        <div class="announcement-overlay">
                            <h3>New Workshops Announced</h3>
                            <p>Starting September 2025</p>
                            <p>For beginners and experts alike - expand your skills</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Newsletter Section -->
    <section class="newsletter">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-lg-8 text-center">
                    <h2 class="mb-4">Stay Updated with Our Latest News</h2>
                    <p class="mb-4">Subscribe to our newsletter to receive updates about upcoming competitions, exhibitions, and workshops.</p>
                    <form class="newsletter-form d-flex">
                        <input type="email" class="form-control me-2" placeholder="Your Email Address">
                        <button class="btn btn-newsletter">Subscribe</button>
                    </form>
                </div>
            </div>
        </div>
    </section>
    </div>