    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}

@model Competition;

<main class="competition-page">

    <div class="competition-wrapper">

        <!-- Page Header -->
        <div class="competition-header">
            <div>
                <span class="page-eyebrow">
                    <i class="fas fa-palette"></i> COMPETITION MANAGEMENT
                </span>
                <h1>Create New Competition</h1>
                <p>
                    Create a new artistic competition and provide all the necessary details.
                </p>
            </div>

            <div class="header-icon">
                <i class="fas fa-trophy"></i>
            </div>
        </div>


        <!-- Form Card -->
        <div class="competition-card">

            <form method="post"
                  enctype="multipart/form-data"
                  asp-controller="Home"
                  asp-action="CreateCompetitions">

                <!-- Basic Information -->
                <div class="form-section">

                    <div class="form-section-title">
                        <div class="section-icon">
                            <i class="fas fa-info-circle"></i>
                        </div>

                        <div>
                            <h3>Competition Information</h3>
                            <p>Enter the basic details of your competition.</p>
                        </div>
                    </div>


                    <div class="form-grid">

                        <!-- Title -->
                        <div class="input-group full-width">
                            <label for="title">
                                Competition Title
                                <span>*</span>
                            </label>

                            <div class="input-wrapper">
                                <i class="fas fa-heading"></i>
                                <input type="text"
                                       id="title"
                                       asp-for="Title"
                                       placeholder="Enter competition title" />
                            </div>

                            <span asp-validation-for="Title"
                                  class="validation-message"></span>
                        </div>


                        <!-- Description -->
                        <div class="input-group full-width">
                            <label for="description">
                                Description
                                <span>*</span>
                            </label>

                            <div class="input-wrapper textarea-wrapper">
                                <i class="fas fa-align-left"></i>
                                <textarea id="description"
                                          asp-for="Description"
                                          rows="5"
                                          placeholder="Describe the competition, rules and requirements..."></textarea>
                            </div>

                            <span asp-validation-for="Description"
                                  class="validation-message"></span>
                        </div>


                        <!-- Start Date -->
                        <div class="input-group">
                            <label for="start_date">
                                Start Date
                                <span>*</span>
                            </label>

                            <div class="input-wrapper">
                                <i class="far fa-calendar-alt"></i>
                                <input type="date"
                                       id="start_date"
                                       asp-for="StartDate" />
                            </div>

                            <span asp-validation-for="StartDate"
                                  class="validation-message"></span>
                        </div>


                        <!-- End Date -->
                        <div class="input-group">
                            <label for="end_date">
                                End Date
                                <span>*</span>
                            </label>

                            <div class="input-wrapper">
                                <i class="far fa-calendar-check"></i>
                                <input type="date"
                                       id="end_date"
                                       asp-for="EndDate" />
                            </div>

                            <span asp-validation-for="EndDate"
                                  class="validation-message"></span>
                        </div>

                    </div>

                </div>


                <!-- Competition Settings -->
                <div class="form-section">

                    <div class="form-section-title">
                        <div class="section-icon">
                            <i class="fas fa-sliders-h"></i>
                        </div>

                        <div>
                            <h3>Competition Settings</h3>
                            <p>Configure award and competition status.</p>
                        </div>
                    </div>


                    <div class="form-grid">

                        <!-- Award -->
                        <div class="input-group">
                            <label for="award">
                                Award
                                <span>*</span>
                            </label>

                            <div class="input-wrapper">
                                <i class="fas fa-award"></i>

                                <select asp-for="AwardId" id="award">
                                    <option value="">
                                        Select Award
                                    </option>

                                    @foreach (var award in ViewBag.awards)
                                    {
                                        <option value="@award.Id">
                                            @award.AwardTitle
                                        </option>
                                    }
                                </select>

                                <i class="fas fa-chevron-down select-arrow"></i>
                            </div>

                            <span asp-validation-for="AwardId"
                                  class="validation-message"></span>
                        </div>


                        <!-- Status -->
                        <div class="input-group">
                            <label for="status">
                                Competition Status
                                <span>*</span>
                            </label>

                            <div class="input-wrapper">
                                <i class="fas fa-circle-notch"></i>

                                <select asp-for="Status" id="status">
                                    <option value="">
                                        Select Status
                                    </option>

                                    <option value="OnGoing">
                                        On Going
                                    </option>

                                    <option value="UpComming">
                                        Upcoming
                                    </option>

                                    <option value="Completed">
                                        Completed
                                    </option>
                                </select>

                                <i class="fas fa-chevron-down select-arrow"></i>
                            </div>

                            <span asp-validation-for="Status"
                                  class="validation-message"></span>
                        </div>

                    </div>

                </div>


                <!-- Banner Upload -->
                <div class="form-section">

                    <div class="form-section-title">
                        <div class="section-icon">
                            <i class="fas fa-image"></i>
                        </div>

                        <div>
                            <h3>Competition Banner</h3>
                            <p>Upload an attractive banner for your competition.</p>
                        </div>
                    </div>


                    <div class="upload-area">

                        <input type="file"
                               id="banner"
                               name="competitionimage"
                               accept="image/*" />

                        <label for="banner" class="upload-box">

                            <div class="upload-icon">
                                <i class="fas fa-cloud-upload-alt"></i>
                            </div>

                            <div>
                                <strong>Upload Competition Banner</strong>

                                <span>
                                    Click to browse or drag & drop your image here
                                </span>

                                <small>
                                    PNG, JPG or JPEG • Recommended 1200 × 600px
                                </small>
                            </div>

                        </label>

                        <span asp-validation-for="Banner"
                              class="validation-message"></span>

                    </div>

                </div>


                <!-- Form Actions -->
                <div class="form-actions">

                    <a asp-controller="Home"
                       asp-action="StaffDashboard"
                       class="btn-cancel">
                        <i class="fas fa-arrow-left"></i>
                        Cancel
                    </a>

                    <button type="submit" class="btn-create">
                        <i class="fas fa-plus-circle"></i>
                        Create Competition
                    </button>

                </div>

            </form>

        </div>

    </div>

</main>