@model Exhibition

<main class="main-content">
    <section class="exhibition-form-section">
        <div class="container">

            <div class="exhibition-form-card">

                <!-- Header -->
                <div class="form-header">
                    <div class="form-icon">
                        <i class="fas fa-palette"></i>
                    </div>

                    <div>
                        <h2>Create New Exhibition</h2>
                        <p>Add a new exhibition and showcase upcoming artwork.</p>
                    </div>
                </div>

                <form method="POST"
                      enctype="multipart/form-data"
                      asp-controller="Home"
                      asp-action="CreateExhibitions"
                      class="modern-exhibition-form">

                    <!-- Exhibition Title -->
                    <div class="modern-form-group">
                        <label for="title">
                            <i class="fas fa-heading"></i>
                            Exhibition Title
                        </label>

                        <input type="text"
                               id="title"
                               asp-for="Title"
                               placeholder="Enter exhibition title">

                        <span asp-validation-for="Title"
                              class="validation-message"></span>
                    </div>

                    <!-- Exhibition Date -->
                    <div class="modern-form-group">
                        <label for="Exhibition_date">
                            <i class="fas fa-calendar-alt"></i>
                            Exhibition Date
                        </label>

                        <input type="date"
                               id="Exhibition_date"
                               asp-for="ExhibitionDate">

                        <span asp-validation-for="ExhibitionDate"
                              class="validation-message"></span>
                    </div>

                    <!-- Location -->
                    <div class="modern-form-group">
                        <label for="location">
                            <i class="fas fa-map-marker-alt"></i>
                            Location
                        </label>

                        <input type="text"
                               id="location"
                               asp-for="Location"
                               placeholder="Enter exhibition location">

                        <span asp-validation-for="Location"
                              class="validation-message"></span>
                    </div>

                    <!-- Status -->
                    <div class="modern-form-group">
                        <label for="status">
                            <i class="fas fa-circle-check"></i>
                            Exhibition Status
                        </label>

                        <select id="status"
                                asp-for="Status">

                            <option value="">-- Select Status --</option>
                            <option value="OnGoing">OnGoing</option>
                            <option value="UpComming">UpComming</option>
                            <option value="Completed">Completed</option>

                        </select>

                        <span asp-validation-for="Status"
                              class="validation-message"></span>
                    </div>

                    <!-- Banner Upload -->
                    <div class="form-section">

                        <label>
                            <i class="fas fa-image"></i>
                            Exhibition Banner
                        </label>

                        <label for="banner" class="upload-box">

                            <i class="fas fa-cloud-arrow-up"></i>

                            <span>
                                <strong>Click to upload banner</strong>
                                <small>PNG, JPG or JPEG</small>
                            </span>

                        </label>

                        <input type="file"
                               id="banner"
                               name="exhibitionimage"
                               hidden>

                        <span asp-validation-for="Banner"
                              class="validation-message"></span>

                    </div>

                    <!-- Buttons -->
                    <div class="exhibition-form-actions">

                        <a asp-controller="Home"
                           asp-action="Index"
                           class="cancel-btn">
                            Cancel
                        </a>

                        <button type="submit"
                                class="create-exhibition-btn">

                            <i class="fas fa-plus"></i>
                            Create Exhibition

                        </button>

                    </div>

                </form>

            </div>

        </div>
    </section>
</main>