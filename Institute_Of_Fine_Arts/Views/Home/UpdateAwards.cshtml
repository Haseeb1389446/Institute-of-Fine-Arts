@model Award

<main class="main-content">
    <section class="award-form-section">
        <div class="container">

            <div class="award-form-card">

                <!-- Header -->
                <div class="form-header">
                    <div class="form-icon">
                        <i class="fas fa-trophy"></i>
                    </div>

                    <div>
                        <h2>Update Award</h2>
                        <p>Modify the award details and winner information.</p>
                    </div>
                </div>

                <form method="post"
                      asp-controller="Home"
                      asp-action="UpdateAwards"
                      class="modern-award-form">

                    <!-- Award Name -->
                    <div class="modern-form-group">
                        <label for="awardName">
                            <i class="fas fa-award"></i>
                            Award Name
                        </label>

                        <input type="text"
                               id="awardName"
                               asp-for="AwardTitle"
                               placeholder="Enter award name" />

                        <span asp-validation-for="AwardTitle"
                              class="validation-message"></span>
                    </div>

                    <!-- Date -->
                    <div class="modern-form-group">
                        <label for="dateGiven">
                            <i class="fas fa-calendar-alt"></i>
                            Award Date
                        </label>

                        <input type="date"
                               asp-for="AwardedDate"
                               id="dateGiven" />

                        <span asp-validation-for="AwardedDate"
                              class="validation-message"></span>
                    </div>

                    <!-- Winner -->
                    <div class="modern-form-group">
                        <label for="student">
                            <i class="fas fa-user-graduate"></i>
                            Select Winner
                        </label>

                        <select id="student"
                                asp-for="StudentId"
                                asp-items="@(new SelectList(ViewBag.students, "Id", "UserName"))">

                            <option value="">-- Select Student --</option>

                        </select>

                        <span asp-validation-for="StudentId"
                              class="validation-message"></span>
                    </div>

                    <!-- Buttons -->
                    <div class="award-form-actions">

                        <a asp-controller="Home"
                           asp-action="Index"
                           class="cancel-btn">
                            Cancel
                        </a>

                        <button type="submit" class="update-award-btn">
                            <i class="fas fa-save"></i>
                            Update Award
                        </button>

                    </div>

                </form>

            </div>

        </div>
    </section>
</main>