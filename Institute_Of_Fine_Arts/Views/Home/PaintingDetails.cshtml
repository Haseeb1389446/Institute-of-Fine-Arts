    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}
@model Painting

<main class="art-detail-page">

    <!-- Top Header -->
    <section class="art-detail-header">
        <div class="container">

            <a asp-controller="Home"
               asp-action="ViewPaintings"
               class="back-artworks">
                <i class="fas fa-arrow-left"></i>
                Back to Artworks
            </a>

            <div class="detail-heading">
                <span>ARTWORK DETAILS</span>
                <h1>@Model.PaintingName</h1>
                <p>Discover the story and details behind this artwork.</p>
            </div>

        </div>
    </section>


    <!-- Artwork Details -->
    <section class="art-detail-section">

        <div class="container">

            <div class="art-detail-card">

                <!-- Artwork Image -->
                <div class="detail-image">

                    <img src="~/Uploads/images/@Model.PaintingImage"
                         alt="@Model.PaintingName" />

                    <div class="image-label">
                        <i class="fas fa-palette"></i>
                        Featured Artwork
                    </div>

                </div>


                <!-- Artwork Information -->
                <div class="detail-content">

                    <div class="detail-top">

                        <div>
                            <span class="detail-label">
                                ARTWORK
                            </span>

                            <h2>@Model.PaintingName</h2>
                        </div>

                        <div class="grade-box">
                            <small>GRADE</small>
                            <strong>
                                @* @(string.IsNullOrEmpty(Model.Grade) ? "N/A" : Model.Grade) *@
                            </strong>
                        </div>

                    </div>


                    <!-- Artist -->
                    <div class="detail-artist">

                        <div class="artist-avatar-large">
                            @* @(Model.Student?.UserName?.Substring(0, 1).ToUpper() ?? "A") *@
                        </div>

                        <div>
                            <small>CREATED BY</small>
                            <h4>
                                @* @(Model.Student?.UserName ?? "Unknown Artist") *@
                            </h4>
                        </div>

                    </div>


                    <!-- Meta Information -->
                    <div class="detail-meta">

                        <div class="meta-item">
                            <i class="fas fa-trophy"></i>

                            <div>
                                <span>Competition</span>
                                <strong>
                                    @* @(Model.Competition?.Title ?? "Not Assigned") *@
                                </strong>
                            </div>
                        </div>


                        <div class="meta-item">
                            <i class="far fa-calendar-alt"></i>

                            <div>
                                <span>Submitted On</span>
                                <strong>
                                    @Model.DatePosted
                                </strong>
                            </div>
                        </div>

                    </div>


                    <!-- Description -->
                    <div class="detail-block">

                        <span class="detail-label">
                            ABOUT THE ARTWORK
                        </span>

                        <p>
                            @Model.Description
                        </p>

                    </div>


                    <!-- Poem / Quote -->
                    @if (!string.IsNullOrEmpty(Model.PoemOrQuote))
                    {
                        <div class="quote-box">

                            <i class="fas fa-quote-left"></i>

                            <div>
                                <span>ARTIST'S WORDS</span>

                                <p>
                                    @Model.PoemOrQuote
                                </p>
                            </div>

                        </div>
                    }


                    <!-- Remarks -->
                    @* @if (!string.IsNullOrEmpty(Model.Remarks)) *@
                    {
                    <div class="remarks-box">

                        <div class="remarks-icon">
                            <i class="fas fa-comment-dots"></i>
                        </div>

                        <div>
                            <span>JUDGE'S REMARKS</span>

                            <p>
                                @* @Model.Remarks *@
                            </p>
                        </div>

                    </div>
                    }


                    <!-- Footer -->
                    <div class="detail-footer">

                        <div class="review-status">
                            <i class="fas fa-check-circle"></i>
                            Artwork Reviewed
                        </div>

                        <a asp-controller="Home"
                           asp-action="ViewPaintings"
                           class="back-button">
                            <i class="fas fa-arrow-left"></i>
                            Explore More
                        </a>

                    </div>

                </div>

            </div>

        </div>

    </section>

</main>