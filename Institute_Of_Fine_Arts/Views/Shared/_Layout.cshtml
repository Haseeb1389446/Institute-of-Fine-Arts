@using Microsoft.AspNetCore.Identity;
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Institute of Fine Arts - Where Creativity Meets Excellence</title>
    <link rel="icon" type="image/x-icon" href="~/images/favicon.png">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/Institute_Of_Fine_Arts.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/styles.css" asp-append-version="true" />
</head>
<body>
    <!-- Modern Navigation -->
<nav class="main-navbar">
    <div class="navbar-container">

        <!-- Brand -->
        <a class="navbar-brand-custom"
           asp-controller="Home"
           asp-action="Index">

            <span class="brand-icon">
                <i class="fas fa-palette"></i>
            </span>

            <span class="brand-text">
                Institute <span>of Fine Arts</span>
            </span>

        </a>


        <!-- Mobile Toggle -->
        <button class="navbar-toggle"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#navbarNav"
                aria-controls="navbarNav"
                aria-expanded="false"
                aria-label="Toggle navigation">

            <i class="fas fa-bars"></i>

        </button>


        <!-- Navigation -->
        <div class="navbar-collapse" id="navbarNav">

            <ul class="modern-nav-list">

                <li>
                    <a class="modern-nav-link active"
                       asp-controller="Home"
                       asp-action="Index">

                        <span>Home</span>
                    </a>
                </li>


                <li>
                    <a class="modern-nav-link"
                       asp-controller="Home"
                       asp-action="Competitions">

                        <span>Competitions</span>
                    </a>
                </li>


                <li>
                    <a class="modern-nav-link"
                       asp-controller="Home"
                       asp-action="Exhibitions">

                        <span>Exhibitions</span>
                    </a>
                </li>


                <li>
                    <a class="modern-nav-link"
                       asp-controller="Home"
                       asp-action="Awards">

                        <span>Gallery</span>
                    </a>
                </li>


                <li>
                    <a class="modern-nav-link"
                       asp-controller="Home"
                       asp-action="About">

                        <span>About</span>
                    </a>
                </li>


                <li>
                    <a class="modern-nav-link"
                       asp-controller="Home"
                       asp-action="Contact">

                        <span>Contact</span>
                    </a>
                </li>


                @if (User.Identity!.IsAuthenticated)
                {
                    <!-- Student -->
                    if (User.IsInRole("Student"))
                    {
                        <li class="user-menu-item">

                            <a class="user-pill"
                               asp-controller="Home"
                               asp-action="Student">

                                <span class="user-avatar">
                                    <i class="fas fa-user"></i>
                                </span>

                                <span class="user-info">
                                    <small>Student</small>
                                    <strong>@User.Identity.Name</strong>
                                </span>

                            </a>

                        </li>
                    }


                    <!-- Staff -->
                    if (User.IsInRole("Staff"))
                    {
                        <li class="user-menu-item">

                            <a class="user-pill"
                               asp-controller="Home"
                               asp-action="Staff">

                                <span class="user-avatar">
                                    <i class="fas fa-chalkboard-teacher"></i>
                                </span>

                                <span class="user-info">
                                    <small>Staff</small>
                                    <strong>@User.Identity.Name</strong>
                                </span>

                            </a>

                        </li>
                    }


                    <!-- Manager -->
                    if (User.IsInRole("Manager"))
                    {
                        <li class="user-menu-item">

                            <a class="user-pill"
                               asp-controller="Home"
                               asp-action="Manager">

                                <span class="user-avatar">
                                    <i class="fas fa-user-tie"></i>
                                </span>

                                <span class="user-info">
                                    <small>Manager</small>
                                    <strong>@User.Identity.Name</strong>
                                </span>

                            </a>

                        </li>
                    }


                    <!-- Admin -->
                    if (User.IsInRole("Admin"))
                    {
                        <li class="user-menu-item">

                            <a class="user-pill"
                               asp-controller="Home"
                               asp-action="Admin">

                                <span class="user-avatar">
                                    <i class="fas fa-shield-alt"></i>
                                </span>

                                <span class="user-info">
                                    <small>Administrator</small>
                                    <strong>Admin</strong>
                                </span>

                            </a>

                        </li>
                    }


                    <!-- Logout -->
                    <li class="logout-item">

                        <form asp-controller="Auth"
                              asp-action="Logout"
                              method="post">

                            <button type="submit"
                                    class="modern-logout">

                                <i class="fas fa-sign-out-alt"></i>

                                <span>Logout</span>

                            </button>

                        </form>

                    </li>
                }
                else
                {
                    <!-- Login -->
                        <li class="login-item user-menu-item">

                        <a class="modern-login"
                           asp-controller="Auth"
                           asp-action="Login">

                            <span>Login</span>

                            <i class="fas fa-arrow-right"></i>

                        </a>

                    </li>
                }

            </ul>

        </div>

    </div>
</nav>
    <div class="container-fluid">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer>
        <div class="container">

            <div class="row">

                <!-- About -->
                <div class="col-lg-4 mb-5 mb-lg-0">

                    <h5 class="footer-title">
                        <i class="fas fa-palette me-2"
                           style="color: var(--primary-color);"></i>
                        Institute of Fine Arts
                    </h5>

                    <p>
                        Where creativity meets excellence. Fostering artistic
                        talent and providing platforms for artists to showcase
                        their work.
                    </p>

                    <div class="social-icons">
                        <a href="#" aria-label="Facebook">
                            <i class="fab fa-facebook-f"></i>
                        </a>

                        <a href="#" aria-label="Instagram">
                            <i class="fab fa-instagram"></i>
                        </a>

                        <a href="#" aria-label="Twitter">
                            <i class="fab fa-twitter"></i>
                        </a>

                        <a href="#" aria-label="YouTube">
                            <i class="fab fa-youtube"></i>
                        </a>
                    </div>

                </div>


                <!-- Quick Links -->
                <div class="col-lg-2 col-md-6 mb-5 mb-lg-0">

                    <h5 class="footer-title">Quick Links</h5>

                    <ul class="footer-links">
                        <li><a href="#">Home</a></li>
                        <li><a href="#">Competitions</a></li>
                        <li><a href="#">Exhibitions</a></li>
                        <li><a href="#">Gallery</a></li>
                        <li><a href="#">About Us</a></li>
                    </ul>

                </div>


                <!-- Resources -->
                <div class="col-lg-3 col-md-6 mb-5 mb-lg-0">

                    <h5 class="footer-title">Resources</h5>

                    <ul class="footer-links">
                        <li><a href="#">Blog</a></li>
                        <li><a href="#">Workshops</a></li>
                        <li><a href="#">Tutorials</a></li>
                        <li><a href="#">Art Supplies</a></li>
                        <li><a href="#">FAQ</a></li>
                    </ul>

                </div>


                <!-- Contact -->
                <div class="col-lg-3 col-md-6">

                    <h5 class="footer-title">Contact Us</h5>

                    <ul class="footer-links">

                        <li>
                            <i class="fas fa-map-marker-alt me-2"></i>
                            123 Art Street, Creative City
                        </li>

                        <li>
                            <i class="fas fa-phone me-2"></i>
                            (123) 456-7890
                        </li>

                        <li>
                            <i class="fas fa-envelope me-2"></i>
                            info@fineartsinstitute.edu
                        </li>

                    </ul>

                </div>

            </div>


            <!-- Copyright -->
            <div class="copyright">
                <p>
                    © 2026 Institute of Fine Arts.
                    All rights reserved.
                </p>
            </div>

        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
